{
  "_note": "HunyuanVideo 1.5 720p image-to-video (ComfyUI API format), mirrored 2026-07-11 from the official template 'video_hunyuan_video_1.5_720p_i2v' with the bypassed EasyCache node and the optional 1080p super-resolution stage omitted. Per the template, BasicScheduler intentionally takes the unshifted model while CFGGuider takes the ModelSamplingSD3 output. Keys starting with '_' are stripped before submission. Injection targets the RIG_* titles; see workflows/README.md.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "hunyuanvideo1.5_720p_i2v_fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load UNet" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "clip_name2": "byt5_small_glyphxl_fp16.safetensors",
      "type": "hunyuan_video_15",
      "device": "default"
    },
    "_meta": { "title": "Load Text Encoders" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "hunyuanvideo15_vae_fp16.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "sigclip_vision_patch14_384.safetensors" },
    "_meta": { "title": "Load CLIP Vision" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "photorealistic young woman holding a branded product toward the camera, natural window lighting, realistic hand-object interaction, subtle camera push-in"
    },
    "_meta": { "title": "RIG_POSITIVE" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "deformed hands, extra fingers, warped face, plastic skin, flicker, morphing label, distorted text, watermark"
    },
    "_meta": { "title": "RIG_NEGATIVE" }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": { "image": "start_frame.png" },
    "_meta": { "title": "RIG_START_IMAGE" }
  },
  "8": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["4", 0],
      "image": ["7", 0],
      "crop": "center"
    },
    "_meta": { "title": "Encode Start Frame" }
  },
  "9": {
    "class_type": "HunyuanVideo15ImageToVideo",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["3", 0],
      "start_image": ["7", 0],
      "clip_vision_output": ["8", 0],
      "width": 720,
      "height": 1280,
      "length": 121,
      "batch_size": 1
    },
    "_meta": { "title": "RIG_LATENT" }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 7 },
    "_meta": { "title": "Sampling Shift" }
  },
  "11": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["10", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "cfg": 6
    },
    "_meta": { "title": "Guider" }
  },
  "12": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": { "title": "Scheduler" }
  },
  "13": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 123456 },
    "_meta": { "title": "RIG_SAMPLER" }
  },
  "14": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" },
    "_meta": { "title": "Sampler Select" }
  },
  "15": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["13", 0],
      "guider": ["11", 0],
      "sampler": ["14", 0],
      "sigmas": ["12", 0],
      "latent_image": ["9", 2]
    },
    "_meta": { "title": "Sample" }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["15", 0], "vae": ["3", 0] },
    "_meta": { "title": "Decode" }
  },
  "17": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["16", 0], "fps": 24 },
    "_meta": { "title": "RIG_VIDEO" }
  },
  "18": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["17", 0],
      "filename_prefix": "rig/hunyuan15",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": { "title": "RIG_OUTPUT" }
  }
}
