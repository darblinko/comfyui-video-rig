# Copy to .env, fill in, then load it into the shell: set -a; . ./.env; set +a
# Named AWS CLI profile. Leave empty to use the default boto3 credential chain.
AWS_PROFILE=
# Overrides [aws] region in rig.config.toml.
AWS_REGION=
# Required: S3 bucket for bootstrap files and run outputs. Bucket names are global.
RIG_OUTPUTS_BUCKET=
# Optional Owner tag on every rig resource.
RIG_OWNER_TAG=
# Optional, only for gated Hugging Face models; stored as an SSM SecureString at launch.
HF_TOKEN=
