# Source revisions that bootstrap.sh installs. A commit SHA pins the checkout.
# An empty value installs the default branch head at bootstrap time.
# Every bootstrap writes the resolved commits and `pip freeze` to
# /opt/rig-bootstrap/installed-versions.txt, and download_models.py writes the
# model revisions and sha256 values to /opt/models/models.lock.json.
COMFYUI_REF=""
COMFYUI_MANAGER_REF=""
VIDEOHELPERSUITE_REF=""
# pip requirement specifiers for PyTorch, for example "torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1".
TORCH_REQUIREMENTS="torch torchvision torchaudio"
